<?xml version="1.0"?>
<launch>
  <!-- Utility launch file for viewing specific flight controller data indices -->
  
  <!-- Main viewing mode selection -->
  <arg name="view_mode" default="single" doc="Mode to view data: 'single', 'group', or 'custom'"/>
  
  <!-- Individual value selection (for 'single' mode) -->
  <arg name="index" default="0" doc="Single data index to view (0-17)"/>
  
  <!-- Custom value selections (for 'custom' mode) -->
  <arg name="index1" default="0" doc="First data index to view"/>
  <arg name="index2" default="1" doc="Second data index to view"/>
  <arg name="index3" default="2" doc="Third data index to view"/>
  <arg name="index4" default="3" doc="Fourth data index to view"/>
  
  <!-- Group selection (for 'group' mode) -->
  <arg name="data_type" default="vicon_pos" doc="Data group: 'vicon_pos', 'vicon_euler', 'est_pos', 'est_vel', 'imu', 'controller'"/>
  
  <!-- Window title customization -->
  <arg name="plot_title" default="" doc="Optional custom title for the plot window"/>
  
  <!-- Individual value with proper scaling (preferred mode) -->
  <group if="$(eval view_mode == 'single')">
    <node pkg="rqt_plot" type="rqt_plot" name="single_value_plot" 
          args="/flight_controller_node/data/data[$(arg index)]" />
          
    <!-- Print what value is being viewed -->
    <node pkg="rocket_integration" type="echo_data_reference" name="single_value_info" output="screen">
      <param name="summary" type="string" value="
   VIEWING SINGLE VALUE:
   -------------------
   Index: $(arg index)
   Description: See data reference below
      "/>
    </node>
  </group>
  
  <!-- Predefined groups of related values -->
  <group if="$(eval view_mode == 'group')">
    <!-- VICON position (values 0-2) -->
    <group if="$(eval data_type == 'vicon_pos')">
      <node pkg="rqt_plot" type="rqt_plot" name="vicon_pos_plot" 
            args="/flight_controller_node/data/data[0] /flight_controller_node/data/data[1] /flight_controller_node/data/data[2]" />
            
      <node pkg="rocket_integration" type="echo_data_reference" name="group_info" output="screen">
        <param name="summary" type="string" value="
     VIEWING DATA GROUP: vicon_pos
     ---------------------
     VICON Position (X,Y,Z) - Indices 0-2
        "/>
      </node>
    </group>
    
    <!-- VICON orientation (values 3-5) -->
    <group if="$(eval data_type == 'vicon_euler')">
      <node pkg="rqt_plot" type="rqt_plot" name="vicon_euler_plot" 
            args="/flight_controller_node/data/data[3] /flight_controller_node/data/data[4] /flight_controller_node/data/data[5]" />
            
      <node pkg="rocket_integration" type="echo_data_reference" name="group_info" output="screen">
        <param name="summary" type="string" value="
     VIEWING DATA GROUP: vicon_euler
     ---------------------
     Euler Angles (Roll,Pitch,Yaw) - Indices 3-5
        "/>
      </node>
    </group>
    
    <!-- Estimator position (values 6-8) -->
    <group if="$(eval data_type == 'est_pos')">
      <node pkg="rqt_plot" type="rqt_plot" name="est_pos_plot" 
            args="/flight_controller_node/data/data[6] /flight_controller_node/data/data[7] /flight_controller_node/data/data[8]" />
            
      <node pkg="rocket_integration" type="echo_data_reference" name="group_info" output="screen">
        <param name="summary" type="string" value="
     VIEWING DATA GROUP: est_pos
     ---------------------
     Estimator Position (X,Y,Z) - Indices 6-8
        "/>
      </node>
    </group>
    
    <!-- Estimator velocity (values 9-11) -->
    <group if="$(eval data_type == 'est_vel')">
      <node pkg="rqt_plot" type="rqt_plot" name="est_vel_plot" 
            args="/flight_controller_node/data/data[9] /flight_controller_node/data/data[10] /flight_controller_node/data/data[11]" />
            
      <node pkg="rocket_integration" type="echo_data_reference" name="group_info" output="screen">
        <param name="summary" type="string" value="
     VIEWING DATA GROUP: est_vel
     ---------------------
     Estimator Velocity (X,Y,Z) - Indices 9-11
        "/>
      </node>
    </group>
    
    <!-- IMU rates (values 12-14) -->
    <group if="$(eval data_type == 'imu')">
      <node pkg="rqt_plot" type="rqt_plot" name="imu_rates_plot" 
            args="/flight_controller_node/data/data[12] /flight_controller_node/data/data[13] /flight_controller_node/data/data[14]" />
            
      <node pkg="rocket_integration" type="echo_data_reference" name="group_info" output="screen">
        <param name="summary" type="string" value="
     VIEWING DATA GROUP: imu
     ---------------------
     IMU Rates (X,Y,Z) - Indices 12-14
        "/>
      </node>
    </group>
    
    <!-- Controller values (values 15-17) -->
    <group if="$(eval data_type == 'controller')">
      <node pkg="rqt_plot" type="rqt_plot" name="controller_plot" 
            args="/flight_controller_node/data/data[15] /flight_controller_node/data/data[16] /flight_controller_node/data/data[17]" />
            
      <node pkg="rocket_integration" type="echo_data_reference" name="group_info" output="screen">
        <param name="summary" type="string" value="
     VIEWING DATA GROUP: controller
     ---------------------
     Controller Values (Thrust in N, Delta Y, Delta Z) - Indices 15-17
        "/>
      </node>
    </group>
  </group>
  
  <!-- Custom selection of values -->
  <group if="$(eval view_mode == 'custom')">
    <node pkg="rqt_plot" type="rqt_plot" name="custom_plot" 
          args="/flight_controller_node/data/data[$(arg index1)] /flight_controller_node/data/data[$(arg index2)] /flight_controller_node/data/data[$(arg index3)] /flight_controller_node/data/data[$(arg index4)]" />
          
    <!-- Print custom selection info -->
    <node pkg="rocket_integration" type="echo_data_reference" name="custom_selection_info" output="screen">
      <param name="summary" type="string" value="
   VIEWING CUSTOM SELECTION:
   ----------------------
   Values: $(arg index1), $(arg index2), $(arg index3), $(arg index4)
      "/>
    </node>
  </group>
  
  <!-- Print data reference for all values -->
  <node pkg="rocket_integration" type="echo_data_reference" name="data_reference" output="screen">
    <param name="summary" type="string" value="
   DATA REFERENCE:
   --------------
   [0-2]: VICON position (X,Y,Z)
   [3-5]: Euler angles (Roll,Pitch,Yaw)
   [6-8]: Estimator position (X,Y,Z)
   [9-11]: Estimator velocity (X,Y,Z)
   [12-14]: IMU rate (X,Y,Z)
   [15-17]: Controller values (Thrust in N, Delta Y, Delta Z)
   
   SUGGESTED USAGE:
   --------------
   View a single value (best for scaling):
     roslaunch rocket_integration view_fc_data.launch view_mode:=single index:=15
   
   View a predefined group:
     roslaunch rocket_integration view_fc_data.launch view_mode:=group data_type:=controller
   
   View custom selection:
     roslaunch rocket_integration view_fc_data.launch view_mode:=custom index1:=0 index2:=6 index3:=9 index4:=15
    "/>
  </node>
</launch> 