<?xml version="1.0"?>
<launch>
  <!-- Set ROS_IP for network communication -->
  <env name="ROS_IP" value="192.168.1.100"/>
  
  <!-- Launch the Vicon UDP node with fixed port -->
  <node pkg="rocket_integration" type="vicon_udp_node" name="vicon_node" output="screen">
    <param name="udp_port" value="57273"/>
  </node>

  <!-- Launch the command center node for user control -->
  <node pkg="rocket_integration" type="command_center" name="command_center" output="screen" />
  
  <!-- Launch the latency monitor node -->
  <node pkg="rocket_integration" type="latency_monitor" name="latency_monitor" output="screen">
    <param name="enable_logging" value="true"/>
    <param name="log_path" value="$(find rocket_integration)/logs/latency_log.csv"/>
  </node>
  
  <!-- Launch rqt_plot for real-time visualization of latency -->
  <node pkg="rqt_plot" type="rqt_plot" name="latency_plot" 
        args="/vicon_node/vicon_latency/data /flight_controller_node/fc_latency/data /latency_monitor/total_latency/data" />
        
  <!-- Launch rqt_graph to visualize the node connections -->
  <node pkg="rqt_graph" type="rqt_graph" name="rqt_graph" />
</launch> 